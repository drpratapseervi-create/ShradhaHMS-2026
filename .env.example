DJANGO_SECRET_KEY=change-me-dev-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Use 'postgres' for DB_ENGINE to use PostgreSQL; anything else will default to SQLite
DB_ENGINE=postgres
DB_NAME=shradha_hms
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# Used by AI Clinical Assist / AI Suggest Medicines / diet chart / LAMA
# consent generation. Set AI_FEATURES_ENABLED=True once OPENAI_API_KEY has
# an account with credits behind it — until then the AI buttons stay hidden
# in the UI.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
AI_FEATURES_ENABLED=False

# WhatsApp (Meta Cloud API) — sends the 'opd_visit_thankyou' template when an
# OPD visit is marked complete. Get these from Meta Business Manager / the
# WhatsApp Cloud API app dashboard.
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
# Only needed for template management (create/list/submit templates), not
# for sending messages. Find it in WhatsApp Manager > API Setup.
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_LANG=en

# ABDM (Ayushman Bharat Digital Mission) — ABHA creation/linking (M1),
# sharing our records as a HIP (M2), and pulling records from other
# facilities as a HIU (M3). Client ID/secret come from the ABDM sandbox
# registration (sandbox.abdm.gov.in); IDs look like SBX_000XXXXX.
ABDM_CLIENT_ID=YOUR_ABDM_CLIENT_ID
ABDM_CLIENT_SECRET=YOUR_ABDM_CLIENT_SECRET
ABDM_HIP_ID=YOUR_ABDM_HIP_ID
# Optional — defaults to ABDM_HIP_ID when blank.
ABDM_HIU_ID=
# Public base URL the ABDM sandbox can reach (not localhost), e.g. an ngrok
# tunnel. HIPs push a patient's encrypted records to this for M3.
ABDM_HIU_CALLBACK_BASE_URL=https://YOUR_PUBLIC_URL
# Sandbox defaults — only override when moving to production.
# ABDM_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
# ABDM_TOKEN_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/sessions
# ABDM_GATEWAY_URL=https://dev.abdm.gov.in
